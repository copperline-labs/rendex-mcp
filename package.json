{
  "name": "@copperline/rendex-mcp",
  "mcpName": "io.github.copperline-labs/rendex-mcp",
  "version": "1.5.1",
  "description": "MCP server for Rendex: render HTML, Markdown, or URLs to images or PDF, apply Mustache data templating, and extract clean reader-mode content, all from AI agents",
  "type": "module",
  "bin": {
    "rendex-mcp": "./dist/stdio.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./stdio": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "prepublishOnly": "rm -rf dist && tsc",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "screenshot",
    "pdf",
    "html-to-image",
    "markdown-to-image",
    "html-to-pdf",
    "content-extraction",
    "rendering",
    "rendex",
    "ai-agent",
    "claude",
    "copperline"
  ],
  "author": "Copperline Labs LLC",
  "license": "MIT",
  "homepage": "https://rendex.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/copperline-labs/rendex-mcp"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "2.108.2",
    "@unkey/api": "2.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250320.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.7.0",
    "wrangler": "4.80.0"
  }
}
